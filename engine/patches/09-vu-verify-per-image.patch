VU verify: also log the first two mismatches of every image. PS2X_VU1_VERIFY / PS2X_VU0_VERIFY logged only the first 50
mismatches overall, so one miscompiled hot image hid the others (Jackass had four; they were found one run at a
time). Debugging aid only; no behaviour change.
Origin: this project (jackass-ps2-recomp), 2026-11-07.

diff --git a/runtime/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp b/runtime/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
index be041f5..74598b2 100644
--- a/runtime/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
+++ b/runtime/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
@@ -19,6 +19,7 @@
 #include <memory>
 #include <string>
 #include <unordered_map>
+#include <mutex>
 #include <vector>
 #include <ps2_log.h>
 
@@ -1522,7 +1523,15 @@ bool VU1InterpreterAccess::runVerifiedWith(VU1Interpreter &vu, uint8_t *vuCode,
     if (!diff.empty())
     {
         ++stats.mismatches;
-        if (stats.mismatches <= 50u)
+        // JA-Port: also the first two mismatches of every image, so one image cannot hide the others.
+        static std::unordered_map<uint64_t, uint32_t> perImage;
+        static std::mutex perImageMutex;
+        bool firstOfImage = false;
+        {
+            std::lock_guard<std::mutex> lock(perImageMutex);
+            firstOfImage = ++perImage[fnv1a64(vuCode, codeSize)] <= 2u;
+        }
+        if (stats.mismatches <= 50u || firstOfImage)
         {
             std::fprintf(stderr, "[vu1-verify] mismatch #%llu run %llu image %016llx entry %04x -> pc %04x/%04x:%s\n",
                          static_cast<unsigned long long>(stats.mismatches), static_cast<unsigned long long>(stats.runs),
