+++ b/runtime/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -300,6 +300,43 @@ namespace
     constexpr uint32_t kGuestHeapSafetyPad = 0x1000u;
     constexpr uint32_t kGuestHeapHardLimit = 0x01F00000u;
 
+    // JA-Port: PS2X_RUNTIME_ARENA=<base>:<limit> (e.g. 0x80000:0x100000): the runtime's own guest allocations
+    // (guestMalloc: SIF command packets, RPC buffers, ...) come from this range only, never from the heap the game
+    // declares with SetupHeap. A game that runs its own malloc over that heap (Jackass's Metrowerks allocator)
+    // otherwise has its blocks overwritten: its heap walk (0x102420) then loops forever on a clobbered block.
+    // The same idea as the Killzone recomp's runtime arena (patch 0008 there). Unset: the old behaviour.
+    struct RuntimeArena
+    {
+        uint32_t base = 0u;
+        uint32_t limit = 0u;
+        explicit operator bool() const { return limit > base; }
+    };
+
+    const RuntimeArena &runtimeArena()
+    {
+        static const RuntimeArena arena = []
+        {
+            RuntimeArena a;
+            const char *value = std::getenv("PS2X_RUNTIME_ARENA");
+            if (!value || !*value)
+                return a;
+            char *end = nullptr;
+            const unsigned long base = std::strtoul(value, &end, 0);
+            if (end && *end == ':')
+            {
+                const unsigned long limit = std::strtoul(end + 1, nullptr, 0);
+                if (limit > base && limit <= PS2_RAM_SIZE)
+                {
+                    a.base = static_cast<uint32_t>(base);
+                    a.limit = static_cast<uint32_t>(limit);
+                    std::fprintf(stderr, "[runtime] guest allocations in the runtime arena 0x%x-0x%x\n", a.base, a.limit);
+                }
+            }
+            return a;
+        }();
+        return arena;
+    }
+
