+                     expect(cpu.gpr[2] == 1u, "sceCdSearchFile did not find a path in the disc image") &&
+                     expect(memory.read32(resultAddress) == 20u, "image search returned the wrong LSN") &&
+                     expect(memory.read32(resultAddress + 4u) == 4u, "image search returned the wrong size");
+
+            const char missing[] = "\\SOUNDS\\NOPE.FSB;1";
+            (void)memory.writeRam(pathAddress, missing, sizeof(missing));
+            cpu = {};
+            cpu.gpr[4] = resultAddress;
+            cpu.gpr[5] = pathAddress;
