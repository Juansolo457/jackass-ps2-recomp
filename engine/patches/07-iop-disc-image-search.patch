-            logString("[IOP printf] ", a0);
+        {
+            // JA-Port: format the arguments (o32: a1-a3, then the stack from sp+16) instead of logging the raw
+            // format string, so module messages such as FMOD's "FMODFile_Open : ERROR - %s" name what failed.
+            const std::string format = m_memory.readString(a0, 2048u);
+            uint32_t argIndex = 1u;
+            const auto nextArg = [&]() -> uint32_t
+            {
+                const uint32_t index = argIndex++;
+                if (index < 4u)
+                    return cpu.gpr[4u + index];
+                return m_memory.read32(cpu.gpr[29] + 16u + (index - 4u) * 4u);
+            };
+            std::string text;
+            for (size_t i = 0u; i < format.size(); ++i)
+            {
+                if (format[i] != '%')
+                {
+                    text += format[i];
+                    continue;
+                }
+                std::string spec = "%";
+                ++i;
+                while (i < format.size() && std::strchr("-+ #0123456789.", format[i]) != nullptr)
+                    spec += format[i++];
+                while (i < format.size() && (format[i] == 'l' || format[i] == 'h'))
+                    ++i;
+                if (i >= format.size())
+                    break;
+                const char conversion = format[i];
+                char buffer[512];
+                switch (conversion)
+                {
+                case '%':
+                    text += '%';
+                    continue;
+                case 's':
+                {
+                    const uint32_t address = nextArg();
+                    const std::string value = address != 0u ? m_memory.readString(address, 256u) : std::string("(null)");
+                    std::snprintf(buffer, sizeof(buffer), (spec + 's').c_str(), value.c_str());
+                    break;
+                }
+                case 'd':
+                case 'i':
+                case 'c':
+                    std::snprintf(buffer, sizeof(buffer), (spec + conversion).c_str(), static_cast<int>(nextArg()));
+                    break;
+                case 'u':
+                case 'x':
+                case 'X':
+                case 'o':
+                    std::snprintf(buffer, sizeof(buffer), (spec + conversion).c_str(), static_cast<unsigned>(nextArg()));
+                    break;
+                case 'p':
+                    std::snprintf(buffer, sizeof(buffer), "0x%08x", static_cast<unsigned>(nextArg()));
+                    break;
+                default:
+                    std::snprintf(buffer, sizeof(buffer), "%%%c", conversion);
+                    break;
+                }
+                text += buffer;
+            }
+            m_host.log(LogLevel::Info, std::string("[IOP printf] ") + text);
+            setV0(static_cast<uint32_t>(text.size()));
             return true;
+        }
