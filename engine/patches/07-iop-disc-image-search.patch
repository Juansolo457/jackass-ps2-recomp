+        // JA-Port: ISO9660 lookup in the mounted image (2048-byte sectors), for sceCdSearchFile.
+        struct ImageEntry
+        {
+            uint32_t lsn = 0u;
+            uint32_t size = 0u;
+            bool directory = false;
+            std::string name;
+        };
+
+        bool readImageSector(uint32_t lsn, uint8_t *destination)
+        {
+            const std::string imagePath = host.hostPath(HostPathKind::CdImage);
+            if (imagePath.empty())
+                return false;
+            if (imageHandle == 0u)
+                imageHandle = host.openHostFile(imagePath);
+            if (imageHandle == 0u)
+                return false;
+            size_t bytesRead = 0u;
+            return host.readHostFile(imageHandle, static_cast<uint64_t>(lsn) * kSectorSize, destination, kSectorSize, bytesRead) &&
+                   bytesRead == kSectorSize;
+        }
+
+        bool searchImage(std::string_view guestPath, ImageEntry &found)
+        {
+            std::array<uint8_t, kSectorSize> sector{};
+            if (!readImageSector(16u, sector.data()) || sector[0] != 1u || std::memcmp(sector.data() + 1u, "CD001", 5u) != 0)
+                return false;
+            const uint8_t *rootRecord = sector.data() + 156u;
+            ImageEntry current;
+            current.lsn = readLe32(rootRecord + 2u);
+            current.size = readLe32(rootRecord + 10u);
+            current.directory = true;
+
+            std::string path(guestPath);
+            const size_t colon = path.find(':');
+            if (colon != std::string::npos)
+                path.erase(0u, colon + 1u);
+            std::replace(path.begin(), path.end(), '\\', '/');
+
+            size_t begin = 0u;
+            while (begin <= path.size())
+            {
+                const size_t end = path.find('/', begin);
+                const std::string component = path.substr(begin, end == std::string::npos ? std::string::npos : end - begin);
+                begin = (end == std::string::npos) ? path.size() + 1u : end + 1u;
+                if (component.empty() || component == ".")
+                    continue;
+                if (!current.directory)
+                    return false;
+                const std::string wanted = normalizedIsoComponent(component);
+                bool matched = false;
+                const uint32_t sectors = (current.size + kSectorSize - 1u) / kSectorSize;
+                for (uint32_t index = 0u; index < sectors && !matched; ++index)
+                {
+                    if (!readImageSector(current.lsn + index, sector.data()))
+                        return false;
+                    size_t offset = 0u;
+                    while (offset < kSectorSize)
+                    {
+                        const uint8_t length = sector[offset];
+                        if (length == 0u || offset + length > kSectorSize)
+                            break;
+                        const uint8_t nameLength = sector[offset + 32u];
+                        if (nameLength > 0u && 33u + nameLength <= length)
+                        {
+                            const std::string identifier(reinterpret_cast<const char *>(sector.data() + offset + 33u), nameLength);
+                            if (!(nameLength == 1u && (identifier[0] == '\0' || identifier[0] == '\1')) &&
+                                normalizedIsoComponent(identifier) == wanted)
+                            {
+                                current.lsn = readLe32(sector.data() + offset + 2u);
+                                current.size = readLe32(sector.data() + offset + 10u);
+                                current.directory = (sector[offset + 25u] & 2u) != 0u;
+                                current.name = identifier;
+                                matched = true;
+                                break;
+                            }
+                        }
+                        offset += length;
+                    }
+                }
+                if (!matched)
+                    return false;
+            }
+            found = current;
+            return true;
+        }
