+    bool testCdvdSearchFileImage()
+    {
+        constexpr size_t kSector = 2048u;
+        std::vector<uint8_t> iso(21u * kSector, 0u);
+        const auto le32 = [&](size_t offset, uint32_t value)
+        {
+            for (uint32_t i = 0u; i < 4u; ++i)
+                iso[offset + i] = static_cast<uint8_t>(value >> (i * 8u));
+        };
+        const auto record = [&](size_t offset, uint32_t lsn, uint32_t size, bool directory, std::string_view name) -> size_t
+        {
+            const size_t length = (33u + name.size() + 1u) & ~size_t{1u};
+            iso[offset] = static_cast<uint8_t>(length);
+            le32(offset + 2u, lsn);
+            le32(offset + 10u, size);
+            iso[offset + 25u] = directory ? 2u : 0u;
+            iso[offset + 32u] = static_cast<uint8_t>(name.size());
+            std::memcpy(iso.data() + offset + 33u, name.data(), name.size());
+            return offset + length;
+        };
+        const size_t pvd = 16u * kSector;
+        iso[pvd] = 1u;
+        std::memcpy(iso.data() + pvd + 1u, "CD001", 5u);
+        (void)record(pvd + 156u, 18u, kSector, true, std::string_view("\0", 1u));
+        iso[17u * kSector] = 255u;
+        size_t offset = 18u * kSector;
+        offset = record(offset, 18u, kSector, true, std::string_view("\0", 1u));
+        offset = record(offset, 18u, kSector, true, std::string_view("\1", 1u));
+        (void)record(offset, 19u, kSector, true, "SOUNDS");
+        offset = 19u * kSector;
+        offset = record(offset, 19u, kSector, true, std::string_view("\0", 1u));
+        offset = record(offset, 18u, kSector, true, std::string_view("\1", 1u));
+        (void)record(offset, 20u, 4u, false, "MENUFX.FSB;1");
+        std::memcpy(iso.data() + 20u * kSector, "FSB3", 4u);
+
+        const auto suffix = std::to_string(
+            static_cast<unsigned long long>(std::chrono::steady_clock::now().time_since_epoch().count()));
+        const std::filesystem::path imagePath =
+            std::filesystem::temp_directory_path() / ("ps2x-iop-cdvd-image-" + suffix + ".iso");
+        {
+            std::ofstream out(imagePath, std::ios::binary);
+            out.write(reinterpret_cast<const char *>(iso.data()), static_cast<std::streamsize>(iso.size()));
+        }
+
+        bool passed = true;
+        {
+            CdImageHost host(imagePath);
+            IopMemory memory;
+            IopKernel kernel(memory);
+            kernel.reset();
+            IopCdvd cdvd(host, memory, kernel);
+            cdvd.reset();
+
+            constexpr uint32_t resultAddress = 0x2400u;
+            constexpr uint32_t pathAddress = 0x2480u;
+            const char path[] = "\\sounds\\menufx.fsb;1";
+            (void)memory.writeRam(pathAddress, path, sizeof(path));
+            IopCpuState cpu{};
+            cpu.gpr[4] = resultAddress;
+            cpu.gpr[5] = pathAddress;
