+    bool IopRpcBridge::handleSifCommand(uint32_t cid, const void *packet, size_t packetSize, IopGuestExecutor &executor)
+    {
+        constexpr size_t kMaxPacketSize = 128u;
+        const auto handler = m_cmdHandlers.find(cid);
+        if (handler == m_cmdHandlers.end() || handler->second.function == 0u || !packet || packetSize < 16u ||
+            packetSize > kMaxPacketSize)
+            return false;
+        // The real sifcmd copies the packet into its receive buffer and calls the handler from the SIF interrupt with
+        // a pointer to it. One scratch packet buffer is enough: handlers run to completion one at a time here.
+        if (m_cmdPacketScratch == 0u)
+            m_cmdPacketScratch = m_memory.allocate(static_cast<uint32_t>(kMaxPacketSize), 16u);
+        if (m_cmdPacketScratch == 0u || !m_memory.writeRam(m_cmdPacketScratch, packet, packetSize))
+            return false;
+        (void)executor.executeGuestFunction(handler->second.function, m_cmdPacketScratch, handler->second.data, 0u, 0u,
+                                            handler->second.gp);
+        return true;
+    }
