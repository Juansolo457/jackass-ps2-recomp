+// JA-Port: PS2X_GIF_PATH_LOG=<seconds>:<count>: after <seconds> of run time, log <count> GIF submissions and VIF1
+// path-3 sync commands (see submitGifPacket and the VIF1 interpreter). True while lines remain; consumes one.
+bool gifPathLogLine()
+{
+    static const auto start = std::chrono::steady_clock::now();
+    static double after = -1.0;
+    static std::atomic<int64_t> left{[]
+    {
+        const char *value = std::getenv("PS2X_GIF_PATH_LOG");
+        unsigned count = 0u;
+        if (value && std::sscanf(value, "%lf:%u", &after, &count) == 2)
+            return static_cast<int64_t>(count);
+        return int64_t{0};
+    }()};
+    if (left.load(std::memory_order_relaxed) <= 0)
+        return false;
+    if (std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count() < after)
+        return false;
+    return left.fetch_sub(1, std::memory_order_relaxed) > 0;
+}
