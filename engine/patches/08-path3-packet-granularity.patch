+
+void PS2Memory::queueMaskedPath3(const uint8_t *data, uint32_t sizeBytes)
+{
+    m_path3Partial.insert(m_path3Partial.end(), data, data + sizeBytes);
+    // Cut complete EOP-terminated GIF packets off the front.
+    size_t pos = 0u;
+    size_t packetStart = 0u;
+    const size_t total = m_path3Partial.size();
+    while (pos + 16u <= total)
+    {
+        uint64_t lo = 0u, hi = 0u;
+        std::memcpy(&lo, m_path3Partial.data() + pos, 8u);
+        std::memcpy(&hi, m_path3Partial.data() + pos + 8u, 8u);
+        const uint64_t nloop = lo & 0x7FFFu;
+        const bool eop = ((lo >> 15) & 1u) != 0u;
+        const uint32_t flg = static_cast<uint32_t>((lo >> 58) & 3u);
+        uint64_t nreg = (lo >> 60) & 0xFu;
+        if (nreg == 0u)
+            nreg = 16u;
+        uint64_t body = 0u;
+        if (flg == 0u)
+            body = nloop * nreg * 16u;
+        else if (flg == 1u)
+            body = ((nloop * nreg + 1u) / 2u) * 16u;
+        else
+            body = nloop * 16u;
+        if (pos + 16u + body > total)
+            break; // the rest of this tag has not arrived yet
+        pos += 16u + static_cast<size_t>(body);
+        if (eop)
+        {
+            m_path3MaskedFifo.emplace_back(m_path3Partial.begin() + static_cast<std::ptrdiff_t>(packetStart),
+                                           m_path3Partial.begin() + static_cast<std::ptrdiff_t>(pos));
+            packetStart = pos;
+        }
+    }
+    if (packetStart != 0u)
+        m_path3Partial.erase(m_path3Partial.begin(), m_path3Partial.begin() + static_cast<std::ptrdiff_t>(packetStart));
+}
+
+void PS2Memory::emitPath3Now(const uint8_t *data, uint32_t sizeBytes)
+{
+    if (!data || sizeBytes < 16u)
+        return;
+    const int savedPath = g_gsTracePath;
+    g_gsTracePath = static_cast<int>(GifPathId::Path3);
+    // The same route as submitGifPacket, so PATH3 stays in order with PATH1/PATH2 packets on the VU/GIF workers.
+    if (m_gifArbiter && m_gifArbiter->empty() && ps2x::asyncvif::submitGif(data, sizeBytes))
+    {
+        g_gsTracePath = savedPath;
+        return;
+    }
+    if (m_gifArbiter)
+    {
+        m_gifArbiter->submit(GifPathId::Path3, data, sizeBytes, false);
+        m_gifArbiter->drain();
+    }
+    else if (m_gifPacketCallback)
+        m_gifPacketCallback(data, sizeBytes);
+    g_gsTracePath = savedPath;
+}
+
+void PS2Memory::releaseOneMaskedPath3Packet()
+{
+    if (m_path3Masked)
+        return;
+    if (!m_path3MaskedFifo.empty())
+    {
+        std::vector<uint8_t> packet = std::move(m_path3MaskedFifo.front());
+        m_path3MaskedFifo.erase(m_path3MaskedFifo.begin());
+        emitPath3Now(packet.data(), static_cast<uint32_t>(packet.size()));
+    }
+    m_path3WindowOpen = !m_path3MaskedFifo.empty() || !m_path3Partial.empty();
+}
+
 void PS2Memory::flushMaskedPath3Packets(bool drainImmediately)
 {
+    if (path3PacketMode())
+    {
+        m_path3WindowOpen = false;
+        if (m_path3Masked)
+            return;
+        if (!m_path3Partial.empty())
+        {
+            m_path3MaskedFifo.push_back(std::move(m_path3Partial));
+            m_path3Partial.clear();
+        }
+        if (m_path3MaskedFifo.empty())
+            return;
+        std::vector<std::vector<uint8_t>> packets;
+        packets.swap(m_path3MaskedFifo);
+        for (const auto &packet : packets)
+            emitPath3Now(packet.data(), static_cast<uint32_t>(packet.size()));
+        (void)drainImmediately;
+        return;
+    }
     if (m_path3Masked || m_path3MaskedFifo.empty())
         return;
 
