# What must never be committed: anything from the game (its disc, executables, modules, assets, translations of
# its code, data derived from it) and anything built from it. tools/audit_repo.py checks what is tracked and
# staged; CI runs it on every push (README.md, "Legal").

# --- The game: your disc and everything extracted, dumped, recorded or captured from it ---
private/
/game/
/data/
*.chd
*.iso
*.cue
*.bin
*.img
*.elf
*.irx
*.pss
*.nps
*.ipu
*.vag
*.adx
*.fsb
SLUS_*
SLES_*
SCUS_*
SCES_*
SYSTEM.CNF
DISK.MAP

# --- Generated translations of the game's code, recorded VU1 microcode, dumped IOP modules ---
/generated/
/generated
/generated_*/
vu1_capture/
iop_modules/

# --- The runtime checkout (engine/runtime.toml) and anything else fetched ---
/engine/runtime/
/third_party/
.tools/

# --- Build output, runtime state ---
/build/
/build
/out/
*.log
*.dmp
*.ps2
*.state
shadercache*/
*.exe
*.dll
*.so
*.lib
*.a
*.obj
*.o
*.pdb
*.ilk
*.zip
*.7z
*.rar

# --- Editor / OS ---
.vscode/
.vs/
.idea/
__pycache__/
Thumbs.db
.DS_Store
