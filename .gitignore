# What must never be committed: anything from the game (its disc, executables, modules, assets,
# translations of its code, data derived from it) and anything built from it. tools/audit_repo.py
# checks what is tracked and staged; CI runs it on every push (README.md, "Legal").

# --- The game: your disc and everything extracted, dumped or captured from it ---
private/
/port*/assets
*.chd
*.iso
*.cue
*.bin
*.img
*.elf
*.irx
*.pss
*.ipu
*.vag
*.adx
SLUS_*
SLES_*
SCUS_*
SCES_*
SYSTEM.CNF

# --- Generated translations of the game's code ---
/port*/generated/

# --- Runtime state: logs, saves, settings, shader caches, crash dumps ---
/port*/logs/
/port*/user*/
/port*/cache*/
/port*/memcard*/
*.log
*.dmp
*.ps2

# --- Build output (programs built from the game's code) and packages ---
/port*/out/
build/
out/
*.exe
*.dll
*.so
*.lib
*.a
*.obj
*.o
*.pdb
*.ilk
*.zip
*.7z
*.rar

# --- Toolchain and upstream checkouts ---
.tools/
third_party/

# --- Editor / OS ---
.vscode/
.vs/
.idea/
__pycache__/
Thumbs.db
.DS_Store
